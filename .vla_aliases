unalias vla-log 2>/dev/null || true
vla-log() {
    local target="${1:-server}"
    case "$target" in
        server|s2v2) tail -f "${VLA_PROJECT_DIR}/logs/s2v2_server.log" ;;
        hub)         tail -f "${VLA_PROJECT_DIR}/logs/hub.log" ;;
